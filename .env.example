# GEMINI_API_KEY: Server-side API key for optional Gemini narrative briefings.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Configurable Gemini model alias (defaults to gemini-4-hydrogen).
GEMINI_MODEL="gemini-4-hydrogen"

# PORT: Express HTTP server port (defaults to 3000).
PORT="3000"

# FASTAPI_BACKEND_URL: Optional URL of the Python FastAPI geospatial backend.
# When reachable, Express proxies /api/v1/* requests to FastAPI; otherwise it reads
# verified pilot artifacts directly from backend/data/pilot/.
FASTAPI_BACKEND_URL="http://127.0.0.1:8000"

# APP_URL: Public base URL when deployed.
APP_URL="MY_APP_URL"

# GEOS_ADMIN_PASSCODE: Optional server-side initial admin override passcode (never exposed to browser).
GEOS_ADMIN_PASSCODE=

# NASA_EARTHDATA_TOKEN: Optional NASA Earthdata Login bearer token for IMERG V07B/V07C HDF5 backfill.
NASA_EARTHDATA_TOKEN=
